{
  "name": "@rodolphobrock/paperclip-notify-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared notification pipeline for Paperclip notifier plugins.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodolphobrock/paperclip-plugins.git",
    "directory": "packages/notify-core"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": ">=2026.916.1"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.916.1"
  }
}
